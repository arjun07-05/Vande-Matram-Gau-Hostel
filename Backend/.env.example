# Database Configuration
# Replace with your actual PostgreSQL credentials in production
DATABASE_URL=postgresql://username:password@db:5432/gau_hostel_db

# Security Settings
# Generate a strong 32-character string for production
SECRET_KEY=supersecretkey_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration
# Comma-separated list of allowed origins or regex
CORS_ORIGINS_REGEX=https?://.*\.compute-1\.amazonaws\.com
