# Database Configuration (PostgreSQL)
# For shared server deployment, configure pool size appropriately
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/gau_hostel_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Security Settings
# IMPORTANT: Generate a strong 32+ character random secret in production
SECRET_KEY=generate_a_secure_random_key_for_production_deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS Configuration
# Comma-separated list of allowed origins (e.g., https://gauhostel.yourdomain.com)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Initial Administrator Credentials (seeded only on fresh database installation)
INITIAL_ADMIN_EMAIL=admin@gauhostel.com
INITIAL_ADMIN_PASSWORD=SetAStrongPassword123!
INITIAL_ADMIN_NAME=Super Admin
